# Copy to .env and fill in. Never commit real secrets.

ENVIRONMENT=development

# postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://sunrise:sunrise@localhost:5433/sunrise

# Shared secret — must match BACKEND_API_KEY in frontend/.env.local.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me

# JSON list of browser origins allowed by CORS
CORS_ORIGINS=["http://localhost:3000"]

# Admin dashboard: sign-in lifetime, and the IANA time zone that defines
# "today" / "this month" in its counts (e.g. Asia/Kolkata, Europe/London).
ADMIN_SESSION_HOURS=12
TIMEZONE=Asia/Kolkata
