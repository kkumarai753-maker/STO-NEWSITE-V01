# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit real secrets.
# Variables WITHOUT the NEXT_PUBLIC_ prefix stay on the server only.
# ---------------------------------------------------------------------------

# Canonical site URL (used for metadata, sitemap, structured data)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Only production may be indexed. Vercel sets VERCEL_ENV automatically; on other
# hosts set SITE_ENV=staging (or anything but "production") for non-live copies,
# which then send noindex everywhere and a disallow-all robots.txt.
# SITE_ENV=production

# Public contact channels (shown in the UI). Leave empty to hide.
# WhatsApp: digits only, international format, no "+" (e.g. 15551234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=918766803990
# Phone: E.164 format (e.g. +15551234567)
NEXT_PUBLIC_PHONE_NUMBER=+918766803990

NEXT_PUBLIC_CONTACT_EMAIL=info@sunrisetechorigin.com

# --- AI assistant (server-only) --------------------------------------------
# Without a key the chatbot runs in demo mode with answers from site content.
ANTHROPIC_API_KEY=
# Optional overrides
# AI_MODEL=claude-opus-5-5
# AI_MAX_TOKENS=2048

# --- Contact form storage: FastAPI + PostgreSQL backend (server-only) -------
# When set, every submission is saved to the database via ../backend and the
# email/webhook options below become optional notifications.
# 127.0.0.1 rather than localhost: on Windows "localhost" may try IPv6 first,
# while the API (uvicorn / docker compose) listens on IPv4 only.
BACKEND_API_URL=
# Set to http://127.0.0.1:8000 only when the backend is running.
# Must match API_KEY in backend/.env (or, against docker compose, the output of
# `docker compose exec backend cat /run/sunrise/api_key`)
BACKEND_API_KEY=

# --- Contact form delivery (server-only) — configure ONE option ------------
# Option A: email via Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL="Website <hello@yourdomain.com>"
# Option B: JSON webhook (Slack, Zapier, n8n, CRM…)
CONTACT_WEBHOOK_URL=

# Self-hosted multi-instance deployments: keep Server Action ids stable
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Vercel Web Analytics: enable it for the project in the Vercel dashboard, then
# set this to "on". Cookieless; the cookie and privacy policies update with it.
# NEXT_PUBLIC_VERCEL_ANALYTICS=on

# /design page (colour, logo, font, background chooser): available in development;
# production builds return 404 unless this is "on".
# NEXT_PUBLIC_DESIGN_LAB=on
