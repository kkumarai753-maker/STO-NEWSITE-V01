# ---------------------------------------------------------------------------
# Optional settings for `docker compose` (docker-compose.yml). Copy to .env to
# change anything; every value below has a working default.
# Never commit .env. For running without Docker, see frontend/.env.example and
# backend/.env.example instead.
# ---------------------------------------------------------------------------

# Shared secret between the website and the API. Leave empty and docker compose
# generates a strong random key on first run (stored in the api-key volume).
# Set it yourself to use a specific key, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# --- Database ---------------------------------------------------------------
POSTGRES_USER=sunrise
POSTGRES_PASSWORD=sunrise
POSTGRES_DB=sunrise

# --- Backend ----------------------------------------------------------------
# production hides /docs and requires API_KEY; development shows /docs.
BACKEND_ENVIRONMENT=production
CORS_ORIGINS=["http://localhost:3000"]
ADMIN_SESSION_HOURS=12
TIMEZONE=Asia/Kolkata

# --- Website: public values (baked in at build — rebuild after changing) -----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=918766803990
NEXT_PUBLIC_PHONE_NUMBER=+918766803990
# off = hide the Design options button and the /design page
NEXT_PUBLIC_CONTACT_EMAIL=info@sunrisetechorigin.com
NEXT_PUBLIC_DESIGN_LAB=

# --- Website: server-only secrets (read at runtime) ---------------------------
ANTHROPIC_API_KEY=
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
CONTACT_WEBHOOK_URL=
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# --- Host ports (change if something else already uses them) -----------------
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=8000
DB_HOST_PORT=5433

# Recruitment (see CAREERS.md). Keep disabled until storage, retention and templates are reviewed.
CAREERS_ENABLED=false
CAREERS_RETENTION_DAYS=0
CAREERS_PRIVACY_APPROVED=false
CAREERS_RETENTION_SCHEDULE_CONFIRMED=false
CAREERS_EMAIL_ENABLED=false
CAREERS_TEMPLATES_APPROVED=false
CAREERS_SENDER=
CAREERS_RESEND_API_KEY=
